{
    "name": "thekiryukha/test-task",
    "type": "project",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "vlucas/phpdotenv": "^5.6",
        "robmorgan/phinx": "^0.16.10"
    },
    "require-dev": {
        "pestphp/pest": "^4.3",
        "rector/rector": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": "php-cs-fixer fix",
        "refactor": "rector",
        "fix": [
            "@refactor",
            "@lint"
        ],
        "test:lint": [
            "php-cs-fixer fix --dry-run",
            "rector --dry-run"
        ],
        "test:types": "phpstan analyse",
        "test:unit": "pest --parallel",
        "test": [
            "@test:lint",
            "@test:unit",
            "@test:types"
        ]
    }
}
